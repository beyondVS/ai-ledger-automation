# =========================================================================
# AI Ledger Automation - 로컬 개발용 통합 환경 변수 템플릿 (backend/.env.example)
# 로컬 개발 시 본 파일을 '.env'로 복사하여 사용하십시오.
# =========================================================================

# 1. PostgreSQL 데이터베이스 인프라 설정
POSTGRES_DB=ai_ledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# 2. Django 백엔드 애플리케이션 핵심 설정
SECRET_KEY=generate_your_secure_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL v18+ 연동 주소 (비밀번호 및 호스트 정보를 일치시키십시오)
DATABASE_URL=postgres://postgres:your_secure_password_here@localhost:5432/ai_ledger
DATABASE_CONN_MAX_AGE=60

# 3. Redis 및 기타 확장 설정 (향후 비동기 연동 대비)
REDIS_URL=redis://localhost:6379/0

# 4. AI 분석 엔진 설정
# Gemini 활성화 여부 및 모델 설정 (True 설정 시 Gemini가 우선 적용되며, 실패 시 Ollama로 폴백됩니다)
GEMINI_ENABLED=False
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama 로컬 개발 연동 설정
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# 5. VAPID 및 웹 푸시 알림 설정
VAPID_PRIVATE_KEY=your_vapid_private_key_base64url
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Firebase Cloud Messaging 서비스 계정 JSON (단일 행 JSON 문자열)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n","client_email":"your_client_email_here"}

