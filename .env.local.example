# =========================================================================
# ai-ledger-automation 로컬 환경 변수 설정 템플릿 (.env.local.example)
# 로컬 개발 시 본 파일을 '.env.local'로 복사하여 사용하십시오.
# (보안을 위해 실제 '.env.local' 파일은 절대 Git에 커밋되지 않습니다.)
# =========================================================================

# -------------------------------------------------------------------------
# 1. PostgreSQL 데이터베이스 인프라 설정 (1일차 셋업 대상)
# -------------------------------------------------------------------------
POSTGRES_DB=ai_ledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Secured_Password18!  # 실제 환경에서는 공백이 없는 강력한 비밀번호로 변경하십시오.
POSTGRES_PORT=5432                     # 로컬 호스트 포트 충돌 시 5433 등으로 변경하십시오.

# -------------------------------------------------------------------------
# 2. 향후 통합 개발 환경 확장 변수 (예고 스택)
# -------------------------------------------------------------------------
# Django API Server Settings
DEBUG=True
SECRET_KEY=local_development_insecure_secret_key_change_me!
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis Connection (Task Queue & Cache)
REDIS_URL=redis://localhost:6379/0
