@echo off
chcp 65001 >nul
title AI 가계부 자동화 프로그램 종료기

echo ==========================================================
echo       AI 가계부 자동화 프로그램 종료기 (Windows)
echo ==========================================================
echo.

docker compose -f "%~dp0..\docker-compose.yml" down
if %errorlevel% neq 0 (
    echo.
    echo [오류] 프로그램 종료 중 에러가 발생했습니다.
    pause
    exit /b 1
)

echo.
echo ==========================================================
echo   ✔ 프로그램이 정상적으로 종료되었습니다.
echo   컴퓨터의 메모리 자원이 반환되었습니다.
echo ==========================================================
echo.
pause
